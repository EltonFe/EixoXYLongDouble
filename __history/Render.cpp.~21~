void TForm1::ogl_draw()
	{

	if(0){
	glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
	glRotatef (2,0,0.0,1);
	glTranslatef(Kx,Ky,0.0);
