long double  *TQuadrilatero::RealocarQuadrilatero(long double *Ponteiro,int Tamanho){
int i=0;
long double *TmpPonteiro=0;
TmpPonteiro=Ponteiro;
   do{

		Ponteiro=(long double*) realloc(Ponteiro,Tamanho*sizeof(long double));
		if(Ponteiro!=NULL){

			return Ponteiro;
		}else{
				Ponteiro=0;
				Ponteiro=TmpPonteiro;
				i++;
			}
   }while(i<0);

   return NULL;

}

TQuadrilatero::TQuadrilatero(){
		MAlpha=0;
		MVetor=0;
		MAlpha2=0;
		MVetor2=0;



}
void TQuadrilatero::AlocarQuadrilatero(int Tam){


	this->MAlpha=(long double*) malloc(Tam*sizeof(long double));
	MVetor=RealocarQuadrilatero(MVetor,Tam);
	MAlpha2=RealocarQuadrilatero(MAlpha2,Tam);
	MVetor2=RealocarQuadrilatero(MVetor2,Tam);
	LAlpha=RealocarQuadrilatero(LAlpha,Tam);
	LVetor=RealocarQuadrilatero(LVetor,Tam);
	LAlpha2=RealocarQuadrilatero(LAlpha2,Tam);
	LVetor2=RealocarQuadrilatero(LVetor2,Tam);

	MZo=RealocarQuadrilatero(MZo,Tam);
	LZo=RealocarQuadrilatero(LZo,Tam);
	MZo2=RealocarQuadrilatero(MZo2,Tam);
	LZo2=RealocarQuadrilatero(LZo2,Tam);


}

