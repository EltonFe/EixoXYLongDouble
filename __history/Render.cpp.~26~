void TForm1::DrawLines(const Objetos *Objects)
{

	const int CountLine=Objects[0].Lines_Atr->GetContador_Line();
	// mesma escala (1/150) dos quadrilateros em DrawDirect
	const float Escala=150;

	if(CountLine<=0)
		return;

	// Variaveis de MoveTo (M) e LineTo (L)
	std::vector<float> MX=ConvertFloat(Objects[0].Lines_Atr->GetMXo_Atr(),CountLine,Escala);
	std::vector<float> MY=ConvertFloat(Objects[0].Lines_Atr->GetMYo_Atr(),CountLine,Escala);
	std::vector<float> MZ=ConvertFloat(Objects[0].Lines_Atr->GetMZo_Atr(),CountLine,Escala);
	std::vector<float> LX=ConvertFloat(Objects[0].Lines_Atr->GetLXo_Atr(),CountLine,Escala);
	std::vector<float> LY=ConvertFloat(Objects[0].Lines_Atr->GetLYo_Atr(),CountLine,Escala);
	std::vector<float> LZ=ConvertFloat(Objects[0].Lines_Atr->GetLZo_Atr(),CountLine,Escala);

	for(int i=0;i<CountLine;i++)
	{
		glColorTColor(Objects[0].Lines_Atr->GetCor_Line(i));
		glVertex3f(MX[i],MY[i],MZ[i]);
		glVertex3f(LX[i],LY[i],LZ[i]);
	}

